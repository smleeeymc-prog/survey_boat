rules_version = '2';

// =============================================================================
// 생성 파일 — 손으로 고치지 말 것. firebase/build-rules.mjs 가
// statistics/shared/survey-taxonomy.js · record-schema.js · db-config.js 에서 만든다.
// 분류값을 바꿨으면:  node firebase/build-rules.mjs  → 커밋 → 배포(HANDOFF.md 13장).
// 배포를 빠뜨리면 새 값으로 낸 제출이 전부 거절된다.
//
// 요지
//   records  읽기: moderation_status == "public" 인 문서만 누구나 (쿼리에도 같은 where가 있어야 한다)
//            생성: 로그인(익명 포함) + 필드·타입·값 범위 전부 + 서버 시각 + 공개 상태 고정
//            수정·삭제: 금지 — 운영자는 콘솔에서 moderation_status 를 "hidden" 으로 (콘솔은 규칙을 우회한다)
//   thumbs   읽기: 짝이 되는 기록이 공개일 때만 / 생성: 기록이 먼저 있어야 / 수정·삭제 금지
//   records_v3 · records_v3_meta  다른 사이트(exhibition-2026) 몫 — firebase/records_v3.rules 를 그대로 끼운다
//   그 밖의 경로는 전부 거부
//
// 글자 수(size)는 UTF-16 코드 단위 — JS .length, textarea maxLength 와 같다.
// trim()은 ASCII 공백만 깎는다 — 설문이 JS trim 으로 먼저 깎아 보낸다.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPublic(data) {
      return data.moderation_status == "public";
    }

    // 앞뒤 공백 없음 + 공백으로만 된 글도 아님(전각 공백·줄바꿈 포함)
    function cleanText(s, maxLen) {
      return s is string
        && s.size() >= 1 && s.size() <= maxLen
        && s == s.trim()
        && !s.matches('(?s)[\\s\\pZ]*');
    }

    // 컬러휠로 고른 배 색 — 소문자 6자리 색 코드만
    function paintHex(v) {
      return v is string && v.matches('^#[0-9a-f]{6}$');
    }

    function validRecord(id, d) {
      return d.keys().hasOnly(["record_id", "created_at", "region", "state", "share", "text", "keywords", "display_name", "consent_public", "consent_archive", "moderation_status", "schema_version", "hull_color", "deck_color", "tube_color", "board_color", "clover_color", "cat_coat", "region_detail", "feeling"])
        && d.keys().hasAll(["record_id", "created_at", "region", "state", "share", "text", "keywords", "display_name", "consent_public", "consent_archive", "moderation_status", "schema_version"])
        && d.record_id == id
        && id.matches('^[A-Za-z0-9]{20}$')
        && d.created_at == request.time
        && d.region in ["아산", "천안", "기타 충남", "충남 밖", "비공개"]
        && d.state in ["stay", "leaving", "between", "returned", "unsure"]
        && d.share in ["many", "close", "few", "none"]
        && cleanText(d.text, 80)
        && d.keywords is list
        && d.keywords.size() <= 2
        && d.keywords.toSet().size() == d.keywords.size()
        && d.keywords.hasOnly(["일", "관계", "가족", "창작", "익숙함", "주거", "불안", "자유", "소속감", "우연"])
        && cleanText(d.display_name, 12)
        && d.consent_public == true
        && d.consent_archive == true
        && d.moderation_status == "public"
        && d.schema_version == 1
        // 배 색 — 있어도 되고 없어도 된다(옛 기록·옛 대기열). 있으면 팔레트 id 중 하나, 또는 컬러휠의 "#rrggbb"
        && (!('hull_color' in d) || d.hull_color in ["base", "red", "orange", "yellow", "green", "blue", "navy", "purple", "black"] || paintHex(d.hull_color))
        && (!('deck_color' in d) || d.deck_color in ["base", "red", "orange", "yellow", "green", "blue", "navy", "purple", "black", "auto"] || paintHex(d.deck_color))
        // 키워드 소품 칠 — 튜브·서핑보드·클로버 색은 배 색과 같은 모양, 고양이는 털 무늬 id
        && (!('tube_color' in d) || d.tube_color in ["base", "red", "orange", "yellow", "green", "blue", "navy", "purple", "black"] || paintHex(d.tube_color))
        && (!('board_color' in d) || d.board_color in ["base", "red", "orange", "yellow", "green", "blue", "navy", "purple", "black"] || paintHex(d.board_color))
        && (!('clover_color' in d) || d.clover_color in ["base", "red", "orange", "yellow", "green", "blue", "navy", "purple", "black"] || paintHex(d.clover_color))
        && (!('cat_coat' in d) || d.cat_coat in ["calico", "white", "cheese", "tuxedo", "black"])
        // 세부 지역 — 있어도 되고 없어도 된다. 있으면 그 지역에 딸린 목록 안의 이름(지금은 '기타 충남'만 세부 목록이 있다)
        && (!('region_detail' in d) || (d.region == "기타 충남" && d.region_detail in ["계룡", "공주", "금산", "논산", "당진", "보령", "부여", "서산", "서천", "예산", "청양", "태안", "홍성"]))
        // Ⅳ 마음(10-30) — 선택 문항. 있으면 문장과 같은 판정(앞뒤 공백 없음 · 공백뿐인 글 안 됨), 40자 이하
        && (!('feeling' in d) || cleanText(d.feeling, 40));
    }

    match /records/{id} {
      // 없는 문서의 get은 허용한다 — 설문이 재전송 전에 "이미 들어갔나"를 확인할 때
      // 없는 문서가 permission-denied 로 돌아오면 숨김 처리된 문서와 구별할 수 없다.
      allow get: if resource == null || isPublic(resource.data);
      allow list: if isPublic(resource.data);
      allow create: if signedIn() && validRecord(id, request.resource.data);
      allow update, delete: if false;
    }

    match /thumbs/{id} {
      allow get: if isPublic(get(/databases/$(database)/documents/records/$(id)).data);
      allow list: if false;
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/records/$(id))
        && request.resource.data.keys().hasOnly(["record_id", "data", "created_at"])
        && request.resource.data.keys().hasAll(["record_id", "data", "created_at"])
        && request.resource.data.record_id == id
        && request.resource.data.created_at == request.time
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 150000
        && request.resource.data.data.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$');
      allow update, delete: if false;
    }

// records_v3 블록 — 기존 저장소(smleeeymc-prog/survey_boat)의 firebase/records_v3.rules로 복사하면 build-rules.mjs가 'match /{document=**}' 앞에 끼운다.
// 원본은 exhibition-2026 firestore/firestore.rules의 같은 블록 — 고치면 그쪽에서 npm run rules:block 후 여기로 다시 복사(값은 exhibition-2026이 관리).
    // ── records_v3 시작 ── 「그래도, 여기 살고 있습니다」 v3(테이프)
    // 값 목록 = src/spec/survey.ts(원본 handoff/spec/survey.ts). 질문 값을 바꾸면 여기도 같이 — 빠뜨리면 제출이 조용히 거절된다.
    // 만들기 = 익명 로그인 필요(기존 records와 같은 기준). 고치기 · 지우기 없음 — 숨길 땐 운영자가 콘솔에서 moderation_status를 'hidden'으로.
    // 검토 = 기존 사이트와 같이 사후 검토: 만들 때 'public', 운영자가 'hidden'으로 내리면 목록 · id 읽기에서 빠진다.
    match /records_v3/{id} {
      allow create: if request.auth != null && isRecordV3(id, request.resource.data);
      allow get: if resource == null || resource.data.moderation_status != 'hidden'; // 다시 보낸 기록이 이미 들어갔는지 확인(검토 전 기록도)
      allow list: if resource.data.moderation_status == 'public' && request.query.limit <= 50;

      function isRecordV3(id, d) {
        let req = ['record_id', 'schema_version', 'region', 'state', 'share', 'text', 'keywords', 'display_name', 'consent_public',
                   'consent_archive', 'shell_kind', 'shell_color', 'pen_color', 'sticker_colors', 'moderation_status', 'created_at'];
        let colors = ['base', 'red', 'orange', 'lemon', 'lime', 'cyan', 'blue', 'violet', 'pink'];
        return d.keys().hasAll(req) && d.keys().hasOnly(req.concat(['region_detail', 'shell_color2', 'specimen_no']))
          && d.record_id == id && id.matches('^[A-Za-z0-9-]{8,64}$')
          && d.schema_version == 3
          && d.region in ['아산', '천안', '기타 충남', '충남 밖', '비공개']
          && (d.region == '기타 충남'
                ? d.get('region_detail', '') in ['계룡', '공주', '금산', '논산', '당진', '보령', '부여', '서산', '서천', '예산', '청양', '태안', '홍성']
                : !('region_detail' in d))
          && d.state in ['stay', 'leaving', 'between', 'returned', 'unsure']
          && d.share in ['many', 'close', 'few', 'none']
          && isTextV3(d.text, 80)
          && d.keywords is list && d.keywords.size() <= 2 && d.keywords.toSet().size() == d.keywords.size()
          && d.keywords.hasOnly(['일', '관계', '가족', '창작', '익숙함', '주거', '불안', '자유', '소속감', '우연'])
          && isTextV3(d.display_name, 12)
          && d.consent_public == true && d.consent_archive == true
          && d.shell_kind in ['clear', 'jelly', 'prism', 'solid', 'duo']
          && d.shell_color in colors
          && (d.shell_kind == 'duo' ? d.get('shell_color2', '') in colors : !('shell_color2' in d))
          && d.pen_color in ['ink', 'blue', 'red']
          && d.sticker_colors is list && d.sticker_colors.size() == d.keywords.size() && d.sticker_colors.hasOnly([0, 1, 2])
          && (!('specimen_no' in d) || (d.specimen_no is int && d.specimen_no >= 1))
          && d.moderation_status == 'public'
          && d.created_at == request.time;
      }

      // 글자 수 = 화면과 같은 '보이는 글자'(grapheme). size()는 UTF-16 단위라 이모지 하나가 2–14로 세진다(에뮬레이터 확인).
      // 결합 부호 · 이음표(ZWJ)와 다음 글자 · 변형 선택자 · 피부색 · 태그 · 한글 중성/종성 자모를 지우고, 국기 한 쌍과 BMP 밖 글자를 한 칸으로 센다.
      // → 화면(Intl.Segmenter)보다 많이 세지 않으므로 화면에서 통과한 글은 늘 통과(rules.test.mjs). 상한 20배(피부색 넣은 4인 가족 이모지 한 글자 = 19)는 장난 글자 막기.
      function isTextV3(s, max) {
        return s is string && s.size() <= max * 20 && s.trim().size() > 0
          && s.replace('[\\p{M}\\x{200C}\\x{FE00}-\\x{FE0F}\\x{1F3FB}-\\x{1F3FF}\\x{E0020}-\\x{E007F}\\x{1160}-\\x{11FF}\\x{D7B0}-\\x{D7FF}]|\\x{200D}.?', '')
              .replace('[\\x{1F1E6}-\\x{1F1FF}]{2}', 'x')
              .replace('[\\x{10000}-\\x{10FFFF}]', 'x')
              .size() <= max;
      }
    }

    // 표본 번호 카운터 — 익명 로그인 후 한 번에 1씩만 오른다(읽기 없음, 커밋 응답이 새 번호)
    match /records_v3_meta/specimen {
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
    // ── records_v3 끝 ──

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
