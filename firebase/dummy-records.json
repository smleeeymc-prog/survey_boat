[
 {
  "record_id": "fx2byHiITrHKytzghOz0",
  "text": "퇴근길 곡교천 은행나무길을 걸으면 하루가 정리돼요. 그 길 때문에 남아요."
 },
 {
  "record_id": "L7Gf3S9nUpmNyLpCs4CX",
  "text": "동네 빵집 사장님이 제 이름을 불러줘요. 그런 곳이 흔치 않잖아요."
 },
 {
  "record_id": "GwvotXRicHrWlCggiKpg",
  "text": "공장 교대근무가 몸에 안 맞아서, 내년 봄엔 다른 일을 찾아 떠나요."
 },
 {
  "record_id": "Fh4S93ULIs1Y7FXpw93P",
  "text": "새벽 KTX로 서울 출근, 밤엔 온양으로. 잠만 자는 집이지만 제 집이에요."
 },
 {
  "record_id": "UEu5F9yQVJ9ze88wXLFo",
  "text": "온천 동네 목욕탕 냄새가 그리워서 돌아왔다고 하면 다들 웃어요."
 },
 {
  "record_id": "rMMOWrSvz2lBijgp21AV",
  "text": "남자친구는 여기 있고 제 꿈은 저기 있어요. 아직 저울질 중이에요."
 },
 {
  "record_id": "lksOCdne7FBU1P4d2x0G",
  "text": "마당 있는 집을 이 값에 구할 수 있는 곳은 여기뿐이었어요."
 },
 {
  "record_id": "RtOnMlU7kebf8m6ciVAq",
  "text": "친구들 결혼식이 다 서울에서 열려요. 제 생활도 이제 그쪽이에요."
 },
 {
  "record_id": "xeAGdjAcmUHflr9geU51",
  "text": "독립서점을 열었어요. 손님은 적어도 제 이름 걸고 하는 일이에요."
 },
 {
  "record_id": "QsTyqAtLZGNnWpstEFXX",
  "text": "두정동 골목 단골집들이 아직 버텨줘서, 저도 버티고 있어요."
 },
 {
  "record_id": "UDuZ5NiycI45oLpwKz97",
  "text": "면접 보러 올라갈 때마다 차비가 아까워서, 아예 올라가기로 했어요."
 },
 {
  "record_id": "YgEkUkMPAxylF9YCOCWn",
  "text": "평일엔 세종 청사, 주말엔 천안 부모님 댁. 반반 사는 사람이에요."
 },
 {
  "record_id": "s2Lg1zPuGIZZRmHAPom7",
  "text": "서울 원룸 월세면 여기서 투룸이에요. 돌아온 이유는 그게 커요."
 },
 {
  "record_id": "KRKUtJwj8rt3GKbhLdLz",
  "text": "호두과자 가게 하시는 부모님이 가게를 물려받을지 물어보세요."
 },
 {
  "record_id": "FqQbJTsrfKY7Oe3Y7ND5",
  "text": "밴드 합주실이 싸고 넓어요. 음악 하기엔 여기가 더 자유로워요."
 },
 {
  "record_id": "aomrL0f1pqriGXdy7LC8",
  "text": "대학 동기들이 다 떠났어요. 혼자 남으니 이상하게 쓸쓸해요."
 },
 {
  "record_id": "5KV70VqWYseyUh6djAwz",
  "text": "천안아산역이 제 두 번째 집 같아요. 대합실 의자까지 익숙해요."
 },
 {
  "record_id": "CjTSrAheGfjtohBLUOkB",
  "text": "공주 한옥마을에서 게스트하우스를 해요. 손님보다 제가 더 행복해요."
 },
 {
  "record_id": "LXkliLjpzoUSQx6jphJi",
  "text": "태안 바다를 보고 자라서 그런지, 도시에선 숨이 막혔어요."
 },
 {
  "record_id": "84F7KTLt0JShfcsdFPug",
  "text": "병원이 멀어요. 아이가 아플 때마다 한 시간씩 운전하는 게 무서워요."
 },
 {
  "record_id": "UNpJN2kjzaMMYOS9a6fv",
  "text": "청년 농부 지원금이 끝나면 어떻게 될지 모르겠어요."
 },
 {
  "record_id": "zf6rTu1ZBiO54Hha1Lkz",
  "text": "홍성과 대전을 오가며 공방 수업을 해요. 길 위에서 아이디어가 나와요."
 },
 {
  "record_id": "KsNjPmdMSxEsqaxE1h61",
  "text": "그냥 여기 사람들이 좋아요. 그 이상 설명이 안 돼요."
 },
 {
  "record_id": "opwW8DD54KvTQ8R3Tv1N",
  "text": "귀농한 부모님 일손 도우러 왔다가 눌러앉았어요."
 },
 {
  "record_id": "16ggZxjZLYt9OcJGYr8m",
  "text": "대전에 살지만 고향 논산이 자꾸 생각나요. 돌아갈 용기는 아직이에요."
 },
 {
  "record_id": "kEfse1Zl4fndglR5eNwu",
  "text": "부산에서 10년 살다 왔어요. 바다는 없지만 가족이 있어요."
 },
 {
  "record_id": "aBOqN7IGChQCMKbK8Zct",
  "text": "서울에 방 하나, 아산에 방 하나. 두 도시 모두 반쯤만 제 거예요."
 },
 {
  "record_id": "VWdKx1iKRy2jmHEGlcUx",
  "text": "일 때문에 충남에 잠깐 왔었는데, 이제 원래 자리로 돌아가요."
 },
 {
  "record_id": "3CPaIxxQK4P90Mvxwfzq",
  "text": "제주에서 왔어요. 우연히 들른 곳에 정이 들어버렸네요."
 },
 {
  "record_id": "zH9aVjFNmNMQTDM79aaL",
  "text": "어디에 있든 불안한 건 똑같더라고요. 그럼 여기가 나아요."
 },
 {
  "record_id": "6hozuZk0kj7fjofe86nc",
  "text": "제 그림 속 풍경이 다 이 동네예요. 떠나면 그릴 게 없어요."
 },
 {
  "record_id": "bzm2Qkrc8NV73d0jx6dF",
  "text": "아무도 저를 모르는 곳에서 처음부터 다시 해보고 싶어요."
 },
 {
  "record_id": "bCoQTcKTRVyHncw3ZZQz",
  "text": "떠날 땐 지겨웠던 조용함이, 돌아오니 선물 같았어요."
 },
 {
  "record_id": "NSvHGvjlrmaZ58TnpsWG",
  "text": "청약이 되면 남고, 안 되면 떠날 것 같아요. 운에 맡겼어요."
 },
 {
  "record_id": "ChlxwNKWsJjM5Jd0Lulh",
  "text": "주말마다 할머니 댁 감나무를 돌보러 와요. 감이 저를 불러요."
 },
 {
  "record_id": "sIKQs5CTAtBZ0pXlwNZK",
  "text": "하고 싶은 공부가 이 지역엔 없어요. 언젠가 배워서 돌아올게요."
 },
 {
  "record_id": "tY51gzAmuNDAxnHMcJwv",
  "text": "동창회에서 다시 만난 친구들 덕분에 돌아올 결심을 했어요."
 },
 {
  "record_id": "M7kBDeE2ZqmXReSLcEFl",
  "text": "청주에서 일하고 천안에서 자라서, 어디 사람이냐 물으면 머뭇거려요."
 },
 {
  "record_id": "B9wt4OiodTRNLMkmimq9",
  "text": "여기 청년 모임에서 처음으로 제 편을 만났어요."
 },
 {
  "record_id": "tzHK0jRCGQ34pUyXUUyk",
  "text": "매일 두 시간씩 도로 위에 있어요. 그 시간이 제 유일한 혼자만의 시간이에요."
 },
 {
  "record_id": "0SL1cFAiAmmsFSmJhBal",
  "text": "월세가 싸서",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "XL0NABi6BXCJhHxzucCd",
  "text": "바다",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "GnudqywF4Lk223XTE9Ub",
  "text": "가족",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "7ZWePdofFb1d3bL6xbOQ",
  "text": "엄마 아프셔서 내려옴",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "BvzylShbYhMWahp7oJck",
  "text": "교대근무 출퇴근",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "rQ7ckhKGj4tZihSmOp2s",
  "text": "주말부부라서",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "Ale7KCNSHVthdEkWEon2",
  "text": "기숙사랑 본가",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "TGO6i3nNAfhBRSQfi2fE",
  "text": "여기 좋은데 미래가 안보여",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "SVIV7HEl2cQ678meozc0",
  "text": "여기 사람들이 좋음",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "sIJdGbIeN8kkHNRgSvhK",
  "text": "고양이 두마리랑 사는 집",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "QYRjWY5oZpkHlu2a7Yg5",
  "text": "고향이니까",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "zFE8i3mToiGuO1UAqMYD",
  "text": "친구들 다 여기 있어서ㅎㅎ",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "6v24lUSGMfFpLkMkWkUX",
  "text": "서울 집값",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "mEHmT6BH1rNeiZuPxneq",
  "text": "학교 다니는중 (디자인과)",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "gi5yQISeQFLQAIVe1Ots",
  "text": "부모님 가게 도와드림",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "n331ukUTUEUjdyxNHgEK",
  "text": "모르겟음",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "DA1tXy8oScTeumrzAICI",
  "text": "그냥..",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "zR0qPLSb9tYNBY817x0s",
  "text": "그냥 익숙해서",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "Xh1iZBOg6w1HHN1gAOfb",
  "text": "곡교천 산책길",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "WDnw7oUcLaJbuT4acsIC",
  "text": "더 큰데서 일해보고 싶음",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "rnd6HcOvSMQitGRf9C9n",
  "text": "일자리가 없음",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "77KI2RmIFNftuWZZaaYb",
  "text": "조용해서 좋음",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "BY3DvcISGITq43VEEGES",
  "text": "두정동 단골 술집",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "cbldE96Nnq62Wm2jyp8n",
  "text": "대전 사는데 공연때문에 자주옴",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "EHO9BCPCH9MygukTLZhA",
  "text": "할게 없음",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "WPIFlbtaqijeQvuHvdCL",
  "text": "병원이 너무 멀어요",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "VKFdVaATElvkgLPvU8WF",
  "text": "서울 생활에 지쳐서",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "PMpSrfMhocbdzJQTJuj4",
  "text": "할머니집",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "drJaX5Q9edWxSLJjWFFK",
  "text": "연애하려고 ㅋㅋ",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "SzC7QBrxi6YUjHgdzaeQ",
  "text": "원래 살던 데로 돌아감",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "csx4RGYtQm0L45BJvbtr",
  "text": "결국 다시 여기",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "eX7DrcaeoyBpsipasACo",
  "text": "이사 갈까 말까",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "88si9zHhqnCkZEZaNYkr",
  "text": "직장때문에 평택 왔다갔다",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "aGDYdKgWocXfhCLj9oIy",
  "text": "남친이 여기 살아서..",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "No8KYFbpk7ALUqzmRvYo",
  "text": "직장은 서울 집은 아산",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "PXLAvPxIV0wHZ0Z2oks8",
  "text": "돈 모이면 생각해볼래요",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "OpLilfZCvyNskv0Wqdlq",
  "text": "문화생활 할게 너무 없다",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "wX5wUaguFHGCbcMbKVMB",
  "text": "아무도 모르는 곳에서 다시 시작하고 싶어서",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "CohYTjLUmLbJVmaOpQpX",
  "text": "사과 농사 가업",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "UBXzf596R3QW8evLHcF8",
  "text": "군대 끝나고 눌러앉음 ㅋㅋ",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "mldueiI1PZVnaStgaWgc",
  "text": "회사가 여기잇음",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "hb4k44MhsR43TsvD5zv8",
  "text": "취업 실패하고 돌아옴...",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "OdOjphiGCZCasa9AmDdc",
  "text": "청년지원금 끝나면 어떡하지",
  "batch": "10-30",
  "thumb": true
 },
 {
  "record_id": "olUlHXEfCA3m9f4waKl3",
  "text": "작업실이 여기 있음",
  "batch": "10-30",
  "thumb": true
 }
]